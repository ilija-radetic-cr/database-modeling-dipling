# Required only for real LLM calls. Never commit the real value.
OPENAI_API_KEY=

# Optional backend overrides.
DBDSL_LLM_BASE_URL=https://api.openai.com/v1
DBDSL_LLM_HTTP_TIMEOUT=180s

# Optional frontend overrides. The development proxy works without these.
VITE_API_MODE=real
VITE_API_BASE_URL=/api/v1

